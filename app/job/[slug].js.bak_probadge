import { useState, useEffect } from 'react';
import { View, Text, ScrollView, TouchableOpacity, ActivityIndicator, Share, TextInput, KeyboardAvoidingView, Platform } from 'react-native';
import { Ionicons } from '@expo/vector-icons';
import { SafeAreaView, useSafeAreaInsets } from 'react-native-safe-area-context';
import { useLocalSearchParams, useRouter } from 'expo-router';
import AsyncStorage from '@react-native-async-storage/async-storage';
import Loader from '../../components/Loader';
import { colors } from '../../lib/colors';
import { fetchJob, submitApplication, hasApplied } from '../../lib/api';
import { addApplied, isSaved, toggleSaved } from '../../lib/storage';

function timeAgo(d) {
  if (!d) return '';
  const days = Math.floor((Date.now() - new Date(d).getTime()) / 86400000);
  if (days < 1) return 'Today';
  if (days === 1) return '1d ago';
  if (days < 7) return days + 'd ago';
  return Math.floor(days / 7) + 'w ago';
}

function extractSkills(t) {
  if (!t) return [];
  const w = t.toLowerCase();
  const sk = ['javascript','python','java','react','sql','mongodb','aws','azure','docker','excel','autocad','sap','salesforce','tableau','agile','devops','machine learning','data analysis','accounting','digital marketing','seo','communication','leadership','supply chain','logistics','electrical','mechanical','civil','hvac','nursing'];
  return sk.filter(s => w.includes(s)).slice(0, 8).map(s => s.split(' ').map(w => w[0].toUpperCase() + w.slice(1)).join(' '));
}

export default function JobDetail() {
  const { slug } = useLocalSearchParams();
  const [job, setJob] = useState(null);
  const [loading, setLoading] = useState(true);
  const [saved, setSaved] = useState(false);
  const [user, setUser] = useState(null);
  const [applyState, setApplyState] = useState('idle'); // idle | open | sending | done | already
  const [coverLetter, setCoverLetter] = useState('');
  const router = useRouter();
  const insets = useSafeAreaInsets();

  useEffect(() => {
    fetchJob(slug).then(d => {
      setJob(d);
      setLoading(false);
      if (d?.id) {
        isSaved(d.id).then(setSaved);
        // Check if user already applied
        AsyncStorage.getItem('user').then(u => {
          if (u) {
            const parsed = JSON.parse(u);
            setUser(parsed);
            if (parsed.uid && d.id) {
              hasApplied(parsed.uid, d.id).then(applied => {
                if (applied) setApplyState('already');
              });
            }
          }
        });
      }
    }).catch(() => setLoading(false));
  }, [slug]);

  if (loading) return <SafeAreaView style={{ flex: 1, backgroundColor: colors.bg, alignItems: 'center', justifyContent: 'center' }}><ActivityIndicator color={colors.primary} size="large" /></SafeAreaView>;
  if (!job || job.error) return <SafeAreaView style={{ flex: 1, backgroundColor: colors.bg, alignItems: 'center', justifyContent: 'center' }}><Text style={{ color: colors.textMuted, fontSize: 16 }}>Job not found</Text><TouchableOpacity onPress={() => router.back()} style={{ marginTop: 16 }}><Text style={{ color: colors.primary }}>← Go back</Text></TouchableOpacity></SafeAreaView>;

  const init = (job.company || '?')[0].toUpperCase();
  const loc = [job.city, job.countryLabel || job.country].filter(Boolean).join(', ');
  const skills = (job.skills && typeof job.skills === 'string' && job.skills.trim().length > 0) ? job.skills.split(',').map(s => s.trim()).filter(Boolean) : extractSkills((job.description || '') + ' ' + (job.responsibilities || ''));
  const expText = job.minExperience ? job.minExperience + '+ yrs' : 'Entry level';

  const onShare = async () => {
    try { await Share.share({ message: `${job.title} at ${job.company}\nhttps://www.jobsaisle.com/job/${slug}` }); } catch {}
  };

  return (
    <SafeAreaView style={{ flex: 1, backgroundColor: colors.bg }} edges={['top']}>
      <Loader visible={applyState === 'sending'} title="Submitting your application" subtitle="Hold tight, this takes a moment." />
      {/* Header */}
      <View style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', paddingHorizontal: 16, paddingVertical: 10 }}>
        <TouchableOpacity onPress={() => router.back()} hitSlop={{ top: 12, bottom: 12, left: 12, right: 12 }} style={{ flexDirection: 'row', alignItems: 'center', paddingVertical: 6, paddingRight: 10, marginLeft: -4 }}>
          <View style={{ width: 28, height: 28, borderRadius: 14, backgroundColor: colors.card, alignItems: 'center', justifyContent: 'center', marginRight: 8 }}>
            <Text style={{ fontSize: 18, color: colors.text, lineHeight: 20, marginTop: -2, fontFamily: 'Inter_500Medium' }}>‹</Text>
          </View>
          <Text style={{ fontSize: 14, color: colors.text, fontFamily: 'Inter_600SemiBold' }}>Back</Text>
        </TouchableOpacity>
        <View style={{ flexDirection: 'row', gap: 8 }}>
          <TouchableOpacity
            onPress={async () => { if (job?.id) { const nowSaved = await toggleSaved(job); setSaved(nowSaved); } }}
            hitSlop={{ top: 8, bottom: 8, left: 8, right: 8 }}
            style={{ width: 36, height: 36, borderRadius: 18, backgroundColor: colors.card, alignItems: 'center', justifyContent: 'center' }}>
            <Ionicons name={saved ? 'heart' : 'heart-outline'} size={18} color={saved ? colors.primary : colors.textMuted} />
          </TouchableOpacity>
          <TouchableOpacity
            onPress={onShare}
            hitSlop={{ top: 8, bottom: 8, left: 8, right: 8 }}
            style={{ width: 36, height: 36, borderRadius: 18, backgroundColor: colors.card, alignItems: 'center', justifyContent: 'center' }}>
            <Ionicons name="share-social-outline" size={18} color={colors.textMuted} />
          </TouchableOpacity>
        </View>
      </View>

      <ScrollView contentContainerStyle={{ paddingBottom: 220 }}>
        {/* Job header */}
        <View style={{ alignItems: 'center', paddingHorizontal: 20, paddingBottom: 20 }}>
          <View style={{ width: 60, height: 60, borderRadius: 18, backgroundColor: 'rgba(52,211,153,0.12)', alignItems: 'center', justifyContent: 'center', marginBottom: 14 }}>
            <Text style={{ fontSize: 22, fontFamily: 'Inter_700Bold', color: colors.primary }}>{init}</Text>
          </View>
          <Text style={{ fontSize: 22, fontFamily: 'Inter_700Bold', color: colors.text, textAlign: 'center', lineHeight: 28 }}>{job.title}</Text>
          <Text style={{ fontSize: 15, color: colors.primary, marginTop: 4, fontFamily: 'Inter_600SemiBold' }}>{job.company}</Text>
          <Text style={{ fontSize: 12, color: colors.textMuted, marginTop: 6, fontFamily: 'Inter_400Regular' }}>📍 {loc} · {timeAgo(job.postedDate)}</Text>
        </View>

        {/* Stats */}
        <View style={{ marginHorizontal: 16, backgroundColor: colors.card, borderWidth: 0.5, borderColor: colors.cardBorder, borderRadius: 16, overflow: 'hidden', marginBottom: 16 }}>
          <View style={{ paddingVertical: 16, paddingHorizontal: 14, alignItems: 'center', borderBottomWidth: 0.5, borderBottomColor: colors.cardBorder }}>
            <Text style={{ fontSize: 20, fontFamily: 'Inter_700Bold', color: colors.text, textAlign: 'center' }} numberOfLines={2}>{job.salaryDisplay || 'N/A'}</Text>
            <Text style={{ fontSize: 10, color: colors.textDim, marginTop: 4, fontFamily: 'Inter_400Regular' }}>per month</Text>
          </View>
          <View style={{ flexDirection: 'row' }}>
            {[[expText, 'experience'], [job.jobType || 'Full Time', 'type']].map(([v, l], i) => (
              <View key={l} style={{ flex: 1, alignItems: 'center', paddingVertical: 12, paddingHorizontal: 6, borderRightWidth: i < 1 ? 0.5 : 0, borderRightColor: colors.cardBorder }}>
                <Text style={{ fontSize: 14, fontFamily: 'Inter_700Bold', color: colors.text, textAlign: 'center' }} numberOfLines={1}>{v}</Text>
                <Text style={{ fontSize: 9, color: colors.textDim, marginTop: 2, fontFamily: 'Inter_400Regular' }}>{l}</Text>
              </View>
            ))}
          </View>
        </View>

        {/* Skills */}
        {skills.length > 0 && (
          <View style={{ paddingHorizontal: 16, marginBottom: 20 }}>
            <Text style={{ fontSize: 14, fontFamily: 'Inter_700Bold', color: colors.text, marginBottom: 10 }}>Skills</Text>
            <View style={{ flexDirection: 'row', flexWrap: 'wrap', gap: 6 }}>
              {skills.map(s => (
                <View key={s} style={{ backgroundColor: 'rgba(52,211,153,0.1)', borderWidth: 0.5, borderColor: 'rgba(52,211,153,0.2)', paddingHorizontal: 10, paddingVertical: 5, borderRadius: 10 }}>
                  <Text style={{ fontSize: 11, color: colors.primary, fontFamily: 'Inter_500Medium' }}>{s}</Text>
                </View>
              ))}
            </View>
          </View>
        )}

        {/* Divider */}
        {skills.length > 0 && job.description && (
          <View style={{ height: 0.5, backgroundColor: colors.cardBorder, marginHorizontal: 16, marginBottom: 16 }} />
        )}

        {/* Description */}
        {job.description && (
          <View style={{ paddingHorizontal: 16, marginBottom: 20 }}>
            <Text style={{ fontSize: 14, fontFamily: 'Inter_700Bold', color: colors.text, marginBottom: 10 }}>About this role</Text>
            <Text style={{ fontSize: 14, color: colors.textMuted, lineHeight: 22, fontFamily: 'Inter_400Regular' }}>{job.description}</Text>
          </View>
        )}

        {/* Pro CTA */}
        <View style={{ marginHorizontal: 16, padding: 16, backgroundColor: 'rgba(226,192,110,0.06)', borderWidth: 0.5, borderColor: 'rgba(226,192,110,0.15)', borderRadius: 16, marginBottom: 16 }}>
          <View style={{ flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
            <View style={{ flex: 1 }}>
              <Text style={{ fontSize: 9, color: colors.gold, fontFamily: 'Inter_700Bold', letterSpacing: 0.5 }}>✦ PRO</Text>
              <Text style={{ fontSize: 13, color: colors.text, marginTop: 4, fontFamily: 'Inter_600SemiBold' }}>Get recruiter's direct email</Text>
              <Text style={{ fontSize: 11, color: colors.textDim, marginTop: 2, fontFamily: 'Inter_400Regular' }}>Skip the queue — message directly</Text>
            </View>
            <TouchableOpacity onPress={() => router.push('/(tabs)/pro')} style={{ backgroundColor: colors.gold, paddingHorizontal: 16, paddingVertical: 10, borderRadius: 10 }}>
              <Text style={{ fontSize: 11, fontFamily: 'Inter_700Bold', color: colors.bg }}>Unlock</Text>
            </TouchableOpacity>
          </View>
        </View>
      </ScrollView>

      {/* Sticky Apply */}
      <KeyboardAvoidingView behavior={Platform.OS === 'ios' ? 'padding' : undefined} style={{ position: 'absolute', bottom: 0, left: 0, right: 0, backgroundColor: colors.bg, borderTopWidth: 0.5, borderTopColor: colors.cardBorder }}>
        <View style={{ paddingHorizontal: 16, paddingTop: 14, paddingBottom: Math.max(insets.bottom + 8, 20) }}>
          {applyState === 'already' && (
            <View style={{ backgroundColor: 'rgba(52,211,153,0.1)', borderWidth: 0.5, borderColor: 'rgba(52,211,153,0.3)', borderRadius: 16, paddingVertical: 16, alignItems: 'center' }}>
              <Text style={{ fontSize: 14, fontFamily: 'Inter_700Bold', color: colors.primary }}>✓ Already Applied</Text>
            </View>
          )}
          {applyState === 'done' && (
            <View style={{ backgroundColor: 'rgba(52,211,153,0.1)', borderWidth: 0.5, borderColor: 'rgba(52,211,153,0.3)', borderRadius: 16, paddingVertical: 16, alignItems: 'center' }}>
              <Text style={{ fontSize: 14, fontFamily: 'Inter_700Bold', color: colors.primary }}>✓ Application Submitted</Text>
              <Text style={{ fontSize: 11, color: colors.textMuted, marginTop: 4, fontFamily: 'Inter_400Regular' }}>Track it in Applied Jobs</Text>
            </View>
          )}
          {applyState === 'open' && (
            <View style={{ gap: 10 }}>
              <Text style={{ fontSize: 12, color: colors.textMuted, fontFamily: 'Inter_500Medium' }}>
                Applying as <Text style={{ color: colors.primary, fontFamily: 'Inter_600SemiBold' }}>{user?.name || user?.email || 'you'}</Text>
              </Text>
              <TextInput
                placeholder="Why are you a good fit? (optional)"
                placeholderTextColor={colors.textDim}
                value={coverLetter}
                onChangeText={setCoverLetter}
                multiline
                numberOfLines={3}
                style={{ backgroundColor: colors.inputBg, borderWidth: 0.5, borderColor: colors.inputBorder, borderRadius: 12, paddingHorizontal: 14, paddingVertical: 10, fontSize: 13, color: colors.text, fontFamily: 'Inter_400Regular', minHeight: 70, textAlignVertical: 'top' }}
              />
              <View style={{ flexDirection: 'row', gap: 8 }}>
                <TouchableOpacity onPress={() => { setApplyState('idle'); setCoverLetter(''); }} style={{ paddingHorizontal: 16, paddingVertical: 12, borderRadius: 12, borderWidth: 0.5, borderColor: colors.cardBorder }}>
                  <Text style={{ fontSize: 13, color: colors.textMuted, fontFamily: 'Inter_500Medium' }}>Cancel</Text>
                </TouchableOpacity>
                <TouchableOpacity
                  disabled={applyState === 'sending'}
                  onPress={async () => {
                    setApplyState('sending');
                    // Get ID token from Firebase Auth to authorize the request server-side
                    let idToken = null;
                    try {
                      const { auth } = require('../../lib/firebase');
                      if (auth.currentUser) idToken = await auth.currentUser.getIdToken();
                    } catch {}
                    const result = await submitApplication({ jobId: job.id, userId: user.uid, coverLetter, idToken });
                    if (result.error === 'already_applied') {
                      setApplyState('already');
                    } else if (result.ok) {
                      addApplied(job);
                      setApplyState('done');
                    } else {
                      setApplyState('open');
                      alert(result.error || 'Failed to submit. Try again.');
                    }
                  }}
                  style={{ flex: 1, backgroundColor: colors.primary, borderRadius: 12, paddingVertical: 12, alignItems: 'center', opacity: applyState === 'sending' ? 0.6 : 1 }}>
                  <Text style={{ fontSize: 14, fontFamily: 'Inter_700Bold', color: colors.bg }}>
                    {applyState === 'sending' ? 'Submitting...' : 'Submit Application'}
                  </Text>
                </TouchableOpacity>
              </View>
            </View>
          )}
          {applyState === 'idle' && (
            <TouchableOpacity
              onPress={() => {
                if (!user || !user.uid) {
                  router.push('/auth');
                  return;
                }
                setApplyState('open');
              }}
              style={{ backgroundColor: colors.primary, borderRadius: 16, paddingVertical: 16 }}>
              <Text style={{ fontSize: 16, fontFamily: 'Inter_700Bold', color: colors.bg, textAlign: 'center' }}>Apply Now →</Text>
            </TouchableOpacity>
          )}
        </View>
      </KeyboardAvoidingView>
    </SafeAreaView>
  );
}
