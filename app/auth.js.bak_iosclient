async function registerPushToken(uid) {
  try {
    const { status } = await Notifications.getPermissionsAsync();
    let finalStatus = status;
    if (status !== 'granted') {
      const r = await Notifications.requestPermissionsAsync();
      finalStatus = r.status;
    }
    if (finalStatus !== 'granted') return;
    const tokenData = await Notifications.getDevicePushTokenAsync();
    const token = tokenData?.data;
    if (!token) return;
    await fetch('https://www.jobsaisle.com/api/notifications/register-token', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ userId: uid, token, platform: tokenData.type || 'unknown' }),
    });
  } catch (e) {
    console.log('[push] register failed:', e?.message);
  }
}

async function syncAuthWithBackend(userProfile) {
  if (!userProfile?.uid || !userProfile?.email) return userProfile;
  try {
    const r = await fetch('https://www.jobsaisle.com/api/auth/sync', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        uid: userProfile.uid,
        email: userProfile.email,
        name: userProfile.displayName || null,
        phone: userProfile.phone || null,
        whatsappOptIn: userProfile.whatsappOptIn ?? null,
      }),
    });
    const data = await r.json();
    if (data.canonicalUid && data.canonicalUid !== userProfile.uid) {
      return { ...userProfile, uid: data.canonicalUid, mergedFrom: userProfile.uid };
    }
  } catch {}
  return userProfile;
}

const inputStyle = {
  backgroundColor: colors.inputBg, borderWidth: 1, borderColor: colors.inputBorder,
  borderRadius: 12, paddingHorizontal: 14, paddingVertical: 13,
  fontSize: 15, color: colors.text, fontFamily: 'Inter_400Regular',
};
const labelStyle = {
  fontSize: 13, color: colors.text, fontFamily: 'Inter_600SemiBold', marginBottom: 6,
};

export default function AuthScreen() {
  const [mode, setMode] = useState('signup');
  const [name, setName] = useState('');
  const [email, setEmail] = useState('');
  const [pw, setPw] = useState('');
  const [showPw, setShowPw] = useState(false);
  const [phone, setPhone] = useState('');
  const [ccIdx, setCcIdx] = useState(0);
  const [showCc, setShowCc] = useState(false);
  const [waOptIn, setWaOptIn] = useState(true);
  const [loading, setLoading] = useState(false);
  const [loaderMsg, setLoaderMsg] = useState({ title: 'Just a moment', subtitle: 'Hang tight...' });
  const [error, setError] = useState('');
  const router = useRouter();

  useEffect(() => {
    AsyncStorage.getItem('authPending').then(v => {
      if (v === '1') {
        setLoading(true);
        setLoaderMsg({ title: 'Signing you in', subtitle: 'Setting up your account...' });
      }
    });
  }, []);

  useEffect(() => {
    const googleCfg = Constants.expoConfig?.extra?.googleAuth || {};
    GoogleSignin.configure({
      webClientId: googleCfg.webClientId,
      offlineAccess: false,
    });
  }, []);

  const attachPhone = (userProfile) => {
    if (mode === 'signup' && phone.trim()) {
      return { ...userProfile, phone: COUNTRY_CODES[ccIdx].code + phone.trim(), whatsappOptIn: waOptIn };
    }
    return userProfile;
  };

  const finishAuth = async (userProfile, isSignup) => {
    userProfile = attachPhone(userProfile);
    userProfile = await syncAuthWithBackend(userProfile);
    if (userProfile?.uid) registerPushToken(userProfile.uid);
    await AsyncStorage.setItem('user', JSON.stringify(userProfile));
    await AsyncStorage.removeItem('authPending');
    if (isSignup) {
      router.replace('/profile-setup');
    } else {
      const p = await fetchProfile(userProfile.uid);
      router.replace(isProfileComplete(p) ? '/(tabs)' : '/profile-setup');
    }
  };

  const handleSubmit = async () => {
    setError('');
    if (mode === 'signup' && !name.trim()) { setError('Enter your name'); return; }
    if (!email.trim()) { setError('Enter email'); return; }
    if (mode === 'signup' && phone.trim() && !/^[0-9]{6,12}$/.test(phone.trim())) { setError('Enter a valid mobile number'); return; }
    if (!pw || pw.length < 6) { setError('Password must be 6+ characters'); return; }
    setLoading(true);
    try {
      const fbUser = mode === 'signup'
        ? await signUpWithEmail(email.trim(), pw, name)
        : await signInWithEmail(email.trim(), pw);
      await finishAuth(userToProfile(fbUser), mode === 'signup');
    } catch (e) {
      setError(authErrorMessage(e));
      await AsyncStorage.removeItem('authPending');
    }
    setLoading(false);
  };

  const handleForgotPassword = async () => {
    setError('');
    if (!email.trim()) { setError('Enter your email first, then tap forgot password'); return; }
    try {
      await sendPasswordReset(email.trim());
      setError('Password reset email sent. Check your inbox.');
    } catch (e) {
      setError(authErrorMessage(e));
    }
  };

  const handleGoogle = async () => {
    setError('');
    setLoading(true);
    try {
      await GoogleSignin.hasPlayServices({ showPlayServicesUpdateDialog: true });
      try { await GoogleSignin.signOut(); } catch (e) {}
      const userInfo = await GoogleSignin.signIn();
      const idToken = userInfo?.idToken || userInfo?.data?.idToken;
      if (!idToken) {
        setError('Could not get Google ID token');
        setLoading(false);
        return;
      }
      const fbUser = await signInWithGoogleIdToken(idToken);
      let userProfile = attachPhone(userToProfile(fbUser));
      userProfile = await syncAuthWithBackend(userProfile);
      if (userProfile?.uid) registerPushToken(userProfile.uid);
      await AsyncStorage.setItem('user', JSON.stringify(userProfile));
      const p = await fetchProfile(userProfile.uid);
      router.replace(isProfileComplete(p) ? '/(tabs)' : '/profile-setup');
    } catch (e) {
      if (e?.code === statusCodes.SIGN_IN_CANCELLED) {
      } else if (e?.code === statusCodes.PLAY_SERVICES_NOT_AVAILABLE) {
        setError('Google Play Services not available');
      } else {
        setError(e?.message || 'Google sign-in failed');
      }
      await AsyncStorage.removeItem('authPending');
    }
    setLoading(false);
  };

  const handleApple = async () => {
    setError('');
    setLoading(true);
    try {
      const rawNonce = Math.random().toString(36).substring(2) + Date.now().toString(36) + Math.random().toString(36).substring(2);
      const hashedNonce = await Crypto.digestStringAsync(Crypto.CryptoDigestAlgorithm.SHA256, rawNonce);
      const cred = await AppleAuthentication.signInAsync({
        requestedScopes: [
          AppleAuthentication.AppleAuthenticationScope.FULL_NAME,
          AppleAuthentication.AppleAuthenticationScope.EMAIL,
        ],
        nonce: hashedNonce,
      });
      if (!cred?.identityToken) { setError('Could not get Apple identity token'); setLoading(false); return; }
      const fbUser = await signInWithAppleIdToken(cred.identityToken, rawNonce);
      let userProfile = attachPhone(userToProfile(fbUser));
      // Apple returns fullName ONLY on first authorization — capture it now or lose it.
      const appleName = [cred.fullName?.givenName, cred.fullName?.familyName].filter(Boolean).join(' ');
      if (appleName && !userProfile.displayName) userProfile = { ...userProfile, displayName: appleName, name: appleName };
      userProfile = await syncAuthWithBackend(userProfile);
      if (userProfile?.uid) registerPushToken(userProfile.uid);
      await AsyncStorage.setItem('user', JSON.stringify(userProfile));
      const pr = await fetchProfile(userProfile.uid);
      router.replace(isProfileComplete(pr) ? '/(tabs)' : '/profile-setup');
    } catch (e) {
      if (e?.code !== 'ERR_REQUEST_CANCELED') setError(e?.message || 'Apple sign-in failed');
      await AsyncStorage.removeItem('authPending');
    }
    setLoading(false);
  };

  const handleLinkedIn = async () => {
    setError('');
    setLoading(true);
    try {
      const linkedInCfg = Constants.expoConfig?.extra?.linkedInAuth || {};
      const clientId = linkedInCfg.clientId;
      if (!clientId) { setError('LinkedIn sign-in not configured'); setLoading(false); return; }
      const redirectUri = 'https://www.jobsaisle.com/api/auth/linkedin/mobile-callback';
      const state = Math.random().toString(36).substring(2, 15);
      const scope = 'openid profile email';
      const authUrl = `https://www.linkedin.com/oauth/v2/authorization?response_type=code&client_id=${clientId}&redirect_uri=${encodeURIComponent(redirectUri)}&state=${state}&scope=${encodeURIComponent(scope)}`;
      const result = await WebBrowser.openAuthSessionAsync(authUrl, 'jobsaisle://linkedin-callback');
      if (result.type !== 'success') { setLoading(false); return; }
      const url = new URL(result.url);
      const code = url.searchParams.get('code');
      const returnedState = url.searchParams.get('state');
      if (!code || returnedState !== state) { setError('LinkedIn auth failed'); setLoading(false); return; }
      const exchangeRes = await fetch('https://www.jobsaisle.com/api/auth/linkedin-exchange', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ code, redirectUri }),
      });
      const data = await exchangeRes.json();
      if (data.error) { setError(data.error); setLoading(false); return; }
      const fbUser = await signInWithLinkedInProfile(data);
      let userProfile = attachPhone(userToProfile(fbUser));
      userProfile = await syncAuthWithBackend(userProfile);
      if (userProfile?.uid) registerPushToken(userProfile.uid);
      await AsyncStorage.setItem('user', JSON.stringify(userProfile));
      const p = await fetchProfile(userProfile.uid);
      router.replace(isProfileComplete(p) ? '/(tabs)' : '/profile-setup');
    } catch (e) {
      setError(e?.message || 'LinkedIn sign-in failed');
    }
    setLoading(false);
  };

  const skip = () => router.replace('/(tabs)');
  const isSignup = mode === 'signup';

  return (
    <SafeAreaView style={{ flex: 1, backgroundColor: colors.bg }}>
      <Loader visible={loading} title={loaderMsg.title} subtitle={loaderMsg.subtitle} />
      <KeyboardAvoidingView style={{ flex: 1 }} behavior={Platform.OS === 'ios' ? 'padding' : undefined}>
        {/* Top bar: wordmark + mode link */}
        <View style={{ flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', paddingHorizontal: 24, paddingTop: 10, paddingBottom: 4 }}>
          <Text style={{ fontSize: 24, color: colors.primary, fontFamily: 'Inter_700Bold', letterSpacing: -0.5 }}>
            Jobs<Text style={{ color: colors.text }}>Aisle</Text>
          </Text>
          <TouchableOpacity onPress={() => { setMode(isSignup ? 'login' : 'signup'); setError(''); }} hitSlop={{ top: 10, bottom: 10, left: 10, right: 10 }}>
            <Text style={{ fontSize: 15, color: colors.primary, fontFamily: 'Inter_700Bold' }}>{isSignup ? 'Login' : 'Register'}</Text>
          </TouchableOpacity>
        </View>

        <ScrollView style={{ flex: 1 }} contentContainerStyle={{ paddingHorizontal: 24, paddingTop: 12, paddingBottom: 16 }} keyboardShouldPersistTaps="handled">
          <Text style={{ fontSize: 26, fontFamily: 'Inter_700Bold', color: colors.text, marginBottom: 4 }}>
            {isSignup ? 'Your next role awaits' : 'Welcome back'}
          </Text>
          <Text style={{ fontSize: 13, color: colors.textMuted, fontFamily: 'Inter_400Regular', marginBottom: 20 }}>
            {isSignup ? 'Jobs across India & the Gulf — one profile' : 'Log in to pick up where you left off'}
          </Text>

          {isSignup && (
            <View style={{ marginBottom: 14 }}>
              <Text style={labelStyle}>Full name</Text>
              <TextInput placeholder="Your name" placeholderTextColor={colors.textDim} value={name} onChangeText={setName} style={inputStyle} />
            </View>
          )}

          <View style={{ marginBottom: 14 }}>
            <Text style={labelStyle}>Email</Text>
            <TextInput placeholder="you@example.com" placeholderTextColor={colors.textDim} value={email} onChangeText={setEmail} keyboardType="email-address" autoCapitalize="none" style={inputStyle} />
          </View>

          {isSignup && (
            <View style={{ marginBottom: 6 }}>
              <Text style={labelStyle}>Mobile number</Text>
              <View style={{ flexDirection: 'row', gap: 8 }}>
                <TouchableOpacity onPress={() => setShowCc(!showCc)} style={{ ...inputStyle, flexDirection: 'row', alignItems: 'center', gap: 6, paddingHorizontal: 12 }}>
                  <Text style={{ fontSize: 15 }}>{COUNTRY_CODES[ccIdx].flag}</Text>
                  <Text style={{ fontSize: 15, color: colors.text, fontFamily: 'Inter_500Medium' }}>{COUNTRY_CODES[ccIdx].code}</Text>
                  <MaterialCommunityIcons name="chevron-down" size={16} color={colors.textDim} />
                </TouchableOpacity>
                <TextInput placeholder="Mobile number" placeholderTextColor={colors.textDim} value={phone} onChangeText={setPhone} keyboardType="phone-pad" style={{ ...inputStyle, flex: 1 }} />
              </View>
              {showCc && (
                <View style={{ flexDirection: 'row', flexWrap: 'wrap', gap: 8, marginTop: 8 }}>
                  {COUNTRY_CODES.map((c, i) => (
                    <TouchableOpacity key={c.code} onPress={() => { setCcIdx(i); setShowCc(false); }} style={{ paddingHorizontal: 10, paddingVertical: 7, borderRadius: 10, borderWidth: 1, borderColor: i === ccIdx ? colors.primary : colors.cardBorder, backgroundColor: i === ccIdx ? 'rgba(13,147,115,0.08)' : colors.inputBg, flexDirection: 'row', gap: 5, alignItems: 'center' }}>
                      <Text style={{ fontSize: 13 }}>{c.flag}</Text>
                      <Text style={{ fontSize: 13, color: colors.text, fontFamily: 'Inter_500Medium' }}>{c.code}</Text>
                    </TouchableOpacity>
                  ))}
                </View>
              )}
              <View style={{ flexDirection: 'row', alignItems: 'center', gap: 8, marginTop: 10, marginBottom: 8 }}>
                <Switch value={waOptIn} onValueChange={setWaOptIn} trackColor={{ false: colors.cardBorder, true: colors.primary }} thumbColor="#FFFFFF" />
                <Text style={{ flex: 1, fontSize: 13, color: colors.textMuted, fontFamily: 'Inter_400Regular' }}>
                  Receive job alerts on <Text style={{ color: '#25D366', fontFamily: 'Inter_600SemiBold' }}>WhatsApp</Text>
                </Text>
              </View>
            </View>
          )}

          <View style={{ marginBottom: isSignup ? 14 : 6 }}>
            <Text style={labelStyle}>Password</Text>
            <View style={{ position: 'relative' }}>
              <TextInput placeholder={isSignup ? 'Create a password (6+ characters)' : 'Password'} placeholderTextColor={colors.textDim} value={pw} onChangeText={setPw} secureTextEntry={!showPw} style={{ ...inputStyle, paddingRight: 44 }} />
              <TouchableOpacity onPress={() => setShowPw(!showPw)} style={{ position: 'absolute', right: 14, top: 13 }}>
                <MaterialCommunityIcons name={showPw ? 'eye-off-outline' : 'eye-outline'} size={20} color={colors.textDim} />
              </TouchableOpacity>
            </View>
          </View>

          {!isSignup && (
            <TouchableOpacity onPress={handleForgotPassword} style={{ alignSelf: 'flex-end', marginBottom: 14 }}>
              <Text style={{ fontSize: 13, color: colors.primary, fontFamily: 'Inter_500Medium' }}>Forgot password?</Text>
            </TouchableOpacity>
          )}

          {/* Divider */}
          <View style={{ flexDirection: 'row', alignItems: 'center', marginVertical: 16, gap: 10 }}>
            <View style={{ flex: 1, height: 1, backgroundColor: colors.cardBorder }} />
            <Text style={{ fontSize: 12, color: colors.textMuted, fontFamily: 'Inter_500Medium' }}>OR</Text>
            <View style={{ flex: 1, height: 1, backgroundColor: colors.cardBorder }} />
          </View>

          {/* Social: square icon buttons */}
          <View style={{ flexDirection: 'row', justifyContent: 'center', gap: 14, marginBottom: 8 }}>
            <TouchableOpacity onPress={handleGoogle} style={{ width: 54, height: 54, borderRadius: 14, backgroundColor: '#FFFFFF', borderWidth: 1, borderColor: colors.cardBorder, alignItems: 'center', justifyContent: 'center' }}>
              <GoogleIcon size={24} />
            </TouchableOpacity>
            <TouchableOpacity onPress={handleLinkedIn} style={{ width: 54, height: 54, borderRadius: 14, backgroundColor: colors.linkedin, alignItems: 'center', justifyContent: 'center' }}>
              <LinkedInIcon size={22} />
            </TouchableOpacity>
            {Platform.OS === 'ios' ? (
              <TouchableOpacity onPress={handleApple} style={{ width: 54, height: 54, borderRadius: 14, backgroundColor: '#000000', alignItems: 'center', justifyContent: 'center' }}>
                <AppleIcon size={24} />
              </TouchableOpacity>
            ) : null}
          </View>
          <Text style={{ fontSize: 12, color: colors.textDim, fontFamily: 'Inter_400Regular', textAlign: 'center', marginBottom: 10 }}>
            We won't post anything on your profile
          </Text>

          {isSignup && (
            <Text style={{ fontSize: 12, color: colors.textMuted, fontFamily: 'Inter_400Regular', lineHeight: 18, marginTop: 4 }}>
              By continuing, you agree to JobsAisle's{' '}
              <Text style={{ color: colors.primary }} onPress={() => WebBrowser.openBrowserAsync('https://www.jobsaisle.com/terms')}>Terms & Conditions</Text> and{' '}
              <Text style={{ color: colors.primary }} onPress={() => WebBrowser.openBrowserAsync('https://www.jobsaisle.com/privacy')}>Privacy Policy</Text>.
            </Text>
          )}

          {error ? <Text style={{ color: colors.red, fontSize: 13, textAlign: 'center', marginTop: 12, fontFamily: 'Inter_400Regular' }}>{error}</Text> : null}
        </ScrollView>

        {/* Sticky bottom CTA */}
        <View style={{ paddingHorizontal: 24, paddingTop: 10, paddingBottom: 14, borderTopWidth: 1, borderTopColor: colors.cardBorder, backgroundColor: colors.bg }}>
          <TouchableOpacity onPress={handleSubmit} disabled={loading} style={{ backgroundColor: colors.primary, borderRadius: 14, paddingVertical: 15, opacity: loading ? 0.6 : 1, flexDirection: 'row', alignItems: 'center', justifyContent: 'center', gap: 8, shadowColor: colors.primary, shadowOpacity: 0.35, shadowRadius: 10, shadowOffset: { width: 0, height: 4 }, elevation: 5 }}>
            <Text style={{ color: '#FFFFFF', fontSize: 16, fontFamily: 'Inter_700Bold' }}>
              {loading ? 'Please wait...' : isSignup ? 'Continue' : 'Login'}
            </Text>
            {!loading && <MaterialCommunityIcons name="arrow-right" size={19} color="#FFFFFF" />}
          </TouchableOpacity>
          <TouchableOpacity onPress={skip} style={{ marginTop: 10, alignItems: 'center' }}>
            <Text style={{ fontSize: 13, color: colors.textGhost, fontFamily: 'Inter_400Regular' }}>Skip for now →</Text>
          </TouchableOpacity>
        </View>
      </KeyboardAvoidingView>
    </SafeAreaView>
  );
}
