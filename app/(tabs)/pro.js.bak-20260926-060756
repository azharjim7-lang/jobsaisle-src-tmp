import { useState, useCallback, useEffect, useRef } from 'react';
import { View, Text, TouchableOpacity, ScrollView, Alert, ActivityIndicator, Platform } from 'react-native';
import { SafeAreaView } from 'react-native-safe-area-context';
import { useRouter, useFocusEffect } from 'expo-router';
import AsyncStorage from '@react-native-async-storage/async-storage';
import * as WebBrowser from 'expo-web-browser';
import { Linking } from 'react-native';
import {
  initConnection, endConnection, fetchProducts, requestPurchase,
  finishTransaction, restorePurchases, getAvailablePurchases,
  purchaseUpdatedListener, purchaseErrorListener,
} from 'expo-iap';
import { colors } from '../../lib/colors';

const API_BASE = 'https://www.jobsaisle.com';
const IOS_SKU = 'com.jobsaisle.app.pro.monthly';
const IS_IOS = Platform.OS === 'ios';

export default function ProScreen() {
  const router = useRouter();
  const [user, setUser] = useState(null);
  const [status, setStatus] = useState(null);
  const [loadingStatus, setLoadingStatus] = useState(true);
  const [paying, setPaying] = useState(false);
  const userRef = useRef(null);
  useEffect(() => { userRef.current = user; }, [user]);

  // Send a StoreKit transaction to our backend, then close it out with Apple.
  const redeemApplePurchase = async (purchase, { silent } = {}) => {
    const u = userRef.current;
    if (!u?.uid) return false;
    try {
      const r = await fetch(`${API_BASE}/api/premium/verify-apple`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ userId: u.uid, transactionId: String(purchase.id) }),
      });
      const d = await r.json();
      if (d.status === 'active') {
        // Only finish once the server has granted entitlement — otherwise a failed
        // verify would lose the transaction permanently.
        await finishTransaction({ purchase, isConsumable: false });
        const sRes = await fetch(`${API_BASE}/api/premium/status`, { headers: { 'x-user-id': u.uid } });
        setStatus(await sRes.json());
        if (!silent) Alert.alert('\u{1F389} Welcome to Pro!', 'Your subscription is active. Unlock recruiter contacts, CV Analyzer, and more.');
        return true;
      }
      if (!silent) Alert.alert('Verification failed', d.error || 'Payment received but not verified. Please contact support.');
    } catch (e) {
      if (!silent) Alert.alert('Verification error', e?.message || 'Please try again.');
    }
    return false;
  };

  // StoreKit delivers purchases through a listener, not just the requestPurchase
  // promise — interrupted or deferred purchases arrive here on next launch.
  useEffect(() => {
    if (!IS_IOS) return;
    let subUpdate, subError, alive = true;
    (async () => {
      try {
        await initConnection();
        if (!alive) return;
        try { await fetchProducts({ skus: [IOS_SKU], type: 'subs' }); } catch {}
        subUpdate = purchaseUpdatedListener(async (purchase) => {
          if (purchase?.productId !== IOS_SKU) return;
          await redeemApplePurchase(purchase);
          setPaying(false);
        });
        subError = purchaseErrorListener((err) => {
          setPaying(false);
          const code = err?.code || '';
          if (code === 'user-cancelled' || code === 'E_USER_CANCELLED') return;
          Alert.alert('Purchase failed', err?.message || 'Please try again.');
        });
      } catch (e) {
        console.log('[iap] init failed:', e?.message);
      }
    })();
    return () => {
      alive = false;
      try { subUpdate?.remove(); subError?.remove(); } catch {}
      endConnection().catch(() => {});
    };
  }, []);

  async function handleAppleSubscribe() {
    setPaying(true);
    try {
      await requestPurchase({ request: { apple: { sku: IOS_SKU } }, type: 'subs' });
      // Success path continues in purchaseUpdatedListener.
    } catch (e) {
      setPaying(false);
      const code = e?.code || '';
      if (code === 'user-cancelled' || code === 'E_USER_CANCELLED') return;
      Alert.alert('Purchase failed', e?.message || 'Please try again.');
    }
  }

  // Apple requires a visible restore path for auto-renewable subscriptions.
  async function handleRestore() {
    if (!user) { router.push('/auth'); return; }
    setPaying(true);
    try {
      await restorePurchases();
      const purchases = await getAvailablePurchases();
      const mine = (purchases || []).filter((x) => x.productId === IOS_SKU);
      let ok = false;
      for (const pch of mine) ok = (await redeemApplePurchase(pch, { silent: true })) || ok;
      Alert.alert(ok ? 'Restored' : 'Nothing to restore',
        ok ? 'Your Pro subscription is active again.' : 'No previous purchase was found for this Apple ID.');
    } catch (e) {
      Alert.alert('Restore failed', e?.message || 'Please try again.');
    }
    setPaying(false);
  }

  // Refresh status whenever screen focuses
  useFocusEffect(useCallback(() => {
    let cancelled = false;
    (async () => {
      setLoadingStatus(true);
      const u = await AsyncStorage.getItem('user');
      const parsed = u ? JSON.parse(u) : null;
      if (!cancelled) setUser(parsed);
      
      if (parsed) {
        try {
          const r = await fetch(`${API_BASE}/api/premium/status`, {
            headers: { 'x-user-id': parsed.uid },
          });
          const d = await r.json();
          if (!cancelled) setStatus(d);
        } catch {
          if (!cancelled) setStatus({ isPremium: false });
        }
      } else {
        if (!cancelled) setStatus({ isPremium: false });
      }
      if (!cancelled) setLoadingStatus(false);
    })();
    return () => { cancelled = true; };
  }, []));

  async function handleSubscribe() {
    if (!user) {
      router.push('/auth');
      return;
    }
    if (IS_IOS) return handleAppleSubscribe();
    setPaying(true);
    try {
      // 1. Create order on backend
      const orderRes = await fetch(`${API_BASE}/api/premium/create-subscription`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          userId: user.uid,
          userName: user.name || user.email?.split('@')[0],
          userEmail: user.email,
          userPhone: user.phone || '',
        }),
      });
      const orderData = await orderRes.json();

      if (!orderData.subscriptionId) {
        Alert.alert('Error', orderData.error || 'Could not start subscription. Please try again.');
        setPaying(false);
        return;
      }

      // 2. Open external browser with payment page that deep-links back on completion
      const qs = new URLSearchParams({
        keyId: orderData.keyId,
        type: 'subscription',
        currency: 'INR',
        name: orderData.userName || user.name || '',
        email: orderData.userEmail || user.email || '',
        phone: orderData.userPhone || '',
        description: 'JobsAisle Pro Monthly',
      }).toString();
      const payUrl = `${API_BASE}/pay/${orderData.subscriptionId}?${qs}`;

      const result = await WebBrowser.openAuthSessionAsync(payUrl, 'jobsaisle://payment-complete');

      // 3. Parse return URL — deep-link returns ?status=success&order_id=...&payment_id=...&signature=...
      if (result.type !== 'success' || !result.url) {
        setPaying(false);
        return;
      }
      const url = new URL(result.url);
      const status = url.searchParams.get('status');

      if (status === 'cancelled') {
        setPaying(false);
        return;
      }
      if (status === 'failed') {
        Alert.alert('Payment failed', url.searchParams.get('error') || 'Please try again.');
        setPaying(false);
        return;
      }
      if (status !== 'success') {
        Alert.alert('Payment incomplete', 'Status: ' + status);
        setPaying(false);
        return;
      }

      // 4. Verify payment on backend (server-side signature check)
      const verifyRes = await fetch(`${API_BASE}/api/premium/verify`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          razorpay_subscription_id: url.searchParams.get('subscription_id'),
          razorpay_payment_id: url.searchParams.get('payment_id'),
          razorpay_signature: url.searchParams.get('signature'),
        }),
      });
      const verifyData = await verifyRes.json();

      if (verifyData.status === 'active') {
        // Refresh status
        const sRes = await fetch(`${API_BASE}/api/premium/status`, {
          headers: { 'x-user-id': user.uid },
        });
        const sData = await sRes.json();
        setStatus(sData);
        Alert.alert(
          '🎉 Welcome to Pro!',
          'Your subscription is active. Unlock recruiter contacts, CV Analyzer, and more.'
        );
      } else {
        Alert.alert('Verification failed', verifyData.error || 'Payment received but verification failed. Please contact support.');
      }
    } catch (err) {
      Alert.alert('Error', err?.message || 'Payment could not be completed.');
    }
    setPaying(false);
  }

  // Loading state
  if (loadingStatus) {
    return (
      <SafeAreaView style={{ flex: 1, backgroundColor: colors.bg, alignItems: 'center', justifyContent: 'center' }}>
        <ActivityIndicator color={colors.primary} />
      </SafeAreaView>
    );
  }

  // Pro member dashboard
  if (status?.isPremium) {
    return (
      <SafeAreaView style={{ flex: 1, backgroundColor: colors.bg }}>
        <ScrollView contentContainerStyle={{ paddingBottom: 40 }}>
          <View style={{ alignItems: 'center', paddingTop: 30, paddingHorizontal: 20 }}>
            <View style={{ backgroundColor: 'rgba(226,192,110,0.12)', borderWidth: 0.5, borderColor: 'rgba(226,192,110,0.35)', paddingHorizontal: 12, paddingVertical: 5, borderRadius: 20, marginBottom: 14 }}>
              <Text style={{ fontSize: 11, color: colors.gold, fontFamily: 'Inter_700Bold', letterSpacing: 1.2 }}>✦ PRO MEMBER</Text>
            </View>
            <Text style={{ fontSize: 22, fontFamily: 'Inter_700Bold', color: colors.text }}>Your Pro Dashboard</Text>
            <Text style={{ fontSize: 12, color: colors.textMuted, marginTop: 6, fontFamily: 'Inter_400Regular' }}>Premium tools & connections</Text>
          </View>

          <View style={{ paddingHorizontal: 16, paddingTop: 24, gap: 12 }}>
            {[
              { icon: '📄', title: 'CV Analyser', desc: 'AI resume scoring & feedback', path: '/premium/cv-analyser', cta: 'Open', gold: false, native: true },
              { icon: '🤝', title: 'Recruiter Connect', desc: 'Direct recruiter contacts', path: '/premium/recruiter-connect', cta: 'Find recruiters', gold: true, native: true },
              { icon: '🎯', title: 'Smart Job Match', desc: 'Jobs matched to your profile', path: '/premium/match', cta: 'View matches', gold: false, native: true },
              { icon: '💰', title: 'Salary Insights', desc: 'Real market salary data', path: '/premium/salary', cta: 'Explore', gold: true, native: true },
              { icon: '🎤', title: 'Interview Prep', desc: 'Practice with AI feedback', path: '/premium/interview', cta: 'Practice', gold: false, native: true },
              { icon: '📝', title: 'CV Maker', desc: 'Build a professional resume', path: '/premium/cv-maker', cta: 'Create', gold: true, native: true },
            ].map((f) => (
              <TouchableOpacity
                key={f.title}
                activeOpacity={0.85}
                onPress={() => f.native ? router.push(f.path) : WebBrowser.openBrowserAsync(`${API_BASE}${f.path}?uid=${user?.uid || ''}`, { toolbarColor: colors.bg, controlsColor: colors.primary })}
                style={{ backgroundColor: colors.card, borderWidth: 1, borderColor: f.gold ? 'rgba(226,192,110,0.25)' : 'rgba(13,147,115,0.3)', borderRadius: 16, padding: 16 }}>
                <Text style={{ fontSize: 26, marginBottom: 6 }}>{f.icon}</Text>
                <Text style={{ fontSize: 15, color: colors.text, fontFamily: 'Inter_700Bold' }}>{f.title}</Text>
                <Text style={{ fontSize: 11, color: colors.textDim, marginTop: 3, fontFamily: 'Inter_400Regular' }}>{f.desc}</Text>
                <View style={{ flexDirection: 'row', alignItems: 'center', justifyContent: 'flex-end', marginTop: 12 }}>
                  <View style={{ backgroundColor: f.gold ? 'rgba(226,192,110,0.15)' : 'rgba(13,147,115,0.18)', paddingHorizontal: 12, paddingVertical: 5, borderRadius: 8 }}>
                    <Text style={{ fontSize: 11, color: f.gold ? colors.gold : colors.primary, fontFamily: 'Inter_700Bold' }}>{f.cta} →</Text>
                  </View>
                </View>
              </TouchableOpacity>
            ))}
          </View>
        </ScrollView>
      </SafeAreaView>
    );
  }

  // Non-Pro upgrade screen
  return (
    <SafeAreaView style={{ flex: 1, backgroundColor: colors.bg }}>
      <ScrollView contentContainerStyle={{ paddingBottom: 30 }}>
        <View style={{ paddingTop: 28, paddingHorizontal: 20, alignItems: 'center' }}>
          <Text style={{ fontSize: 10, color: colors.gold, fontFamily: 'Inter_700Bold', letterSpacing: 1.5 }}>✦ JOBSAISLE PRO</Text>
          <Text style={{ fontSize: 22, fontFamily: 'Inter_700Bold', color: colors.text, textAlign: 'center', marginTop: 8, lineHeight: 30 }}>Stop applying{'\n'}into the void.</Text>
          <Text style={{ fontSize: 12, color: colors.textMuted, textAlign: 'center', marginTop: 8, fontFamily: 'Inter_400Regular' }}>Message hiring managers directly.</Text>
        </View>

        <View style={{ flexDirection: 'row', marginHorizontal: 16, marginTop: 20, backgroundColor: 'rgba(52,211,153,0.06)', borderWidth: 0.5, borderColor: 'rgba(52,211,153,0.12)', borderRadius: 14, overflow: 'hidden' }}>
          {[['16K+', 'Contacts'], ['3.2K', 'Pro users'], ['78%', 'Response']].map(([n, l], i) => (
            <View key={l} style={{ flex: 1, alignItems: 'center', paddingVertical: 14, borderRightWidth: i < 2 ? 0.5 : 0, borderRightColor: 'rgba(52,211,153,0.12)' }}>
              <Text style={{ fontSize: 18, fontFamily: 'Inter_700Bold', color: colors.primary }}>{n}</Text>
              <Text style={{ fontSize: 9, color: colors.textDim, fontFamily: 'Inter_400Regular' }}>{l}</Text>
            </View>
          ))}
        </View>

        <View style={{ marginHorizontal: 16, marginTop: 14, padding: 14, backgroundColor: 'rgba(52,211,153,0.06)', borderWidth: 0.5, borderColor: 'rgba(52,211,153,0.12)', borderRadius: 14 }}>
          <Text style={{ fontSize: 9, color: colors.textDim, fontFamily: 'Inter_700Bold', letterSpacing: 0.5, marginBottom: 8 }}>SAMPLE RECRUITER</Text>
          <View style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
            <View style={{ width: 36, height: 36, borderRadius: 18, backgroundColor: 'rgba(255,255,255,0.1)', alignItems: 'center', justifyContent: 'center' }}>
              <Text style={{ fontSize: 12, fontFamily: 'Inter_600SemiBold', color: colors.text }}>PS</Text>
            </View>
            <View style={{ flex: 1 }}>
              <Text style={{ fontSize: 13, fontFamily: 'Inter_600SemiBold', color: colors.text }}>Priya Sharma</Text>
              <Text style={{ fontSize: 10, color: colors.textMuted, fontFamily: 'Inter_400Regular' }}>Sr Recruiter at ████████</Text>
            </View>
            <Text style={{ fontSize: 8, color: colors.gold, backgroundColor: 'rgba(226,192,110,0.15)', paddingHorizontal: 6, paddingVertical: 2, borderRadius: 4, fontFamily: 'Inter_600SemiBold' }}>🔒</Text>
          </View>
        </View>

        <View style={{ alignItems: 'center', marginTop: 24 }}>
          <Text style={{ fontSize: 40, fontFamily: 'Inter_700Bold', color: colors.text }}>₹199<Text style={{ fontSize: 14, color: colors.textMuted, fontWeight: '400' }}>/mo</Text></Text>
          <Text style={{ fontSize: 10, color: colors.textDim, marginTop: 4, fontFamily: 'Inter_400Regular' }}>Cancel anytime</Text>
        </View>

        <TouchableOpacity
          onPress={handleSubscribe}
          disabled={paying}
          activeOpacity={0.85}
          style={{ marginHorizontal: 16, marginTop: 16, backgroundColor: paying ? colors.cardBorder : colors.forest, borderRadius: 16, paddingVertical: 16, alignItems: 'center', flexDirection: 'row', justifyContent: 'center', gap: 8 }}>
          {paying && <ActivityIndicator color="#FFFFFF" size="small" />}
          <Text style={{ fontSize: 16, fontFamily: 'Inter_700Bold', color: '#FFFFFF' }}>{paying ? 'Processing…' : 'Get Pro Now →'}</Text>
        </TouchableOpacity>

        <View style={{ paddingHorizontal: 16, marginTop: 16 }}>
          {['Unlimited recruiter contacts', 'Direct email & LinkedIn', 'AI CV Analyzer', 'Priority ranking'].map(f => (
            <View key={f} style={{ flexDirection: 'row', alignItems: 'center', gap: 8, paddingVertical: 6 }}>
              <Text style={{ fontSize: 12, color: colors.primary }}>✓</Text>
              <Text style={{ fontSize: 12, color: colors.textMuted, fontFamily: 'Inter_400Regular' }}>{f}</Text>
            </View>
          ))}
        </View>

        {IS_IOS ? (
          <View style={{ paddingHorizontal: 20, marginTop: 24 }}>
            <Text style={{ textAlign: 'center', fontSize: 11, color: colors.textDim, lineHeight: 16, fontFamily: 'Inter_400Regular' }}>
              JobsAisle Pro is a ₹199/month auto-renewable subscription. Payment is charged to your Apple ID at confirmation. It renews automatically unless cancelled at least 24 hours before the end of the period. Manage or cancel anytime in your Apple ID account settings.
            </Text>
            <View style={{ flexDirection: 'row', justifyContent: 'center', gap: 16, marginTop: 12 }}>
              <TouchableOpacity onPress={() => Linking.openURL('https://www.apple.com/legal/internet-services/itunes/dev/stdeula/')}>
                <Text style={{ fontSize: 11, color: colors.primary, fontFamily: 'Inter_600SemiBold', textDecorationLine: 'underline' }}>Terms of Use (EULA)</Text>
              </TouchableOpacity>
              <TouchableOpacity onPress={() => Linking.openURL('https://www.jobsaisle.com/privacy')}>
                <Text style={{ fontSize: 11, color: colors.primary, fontFamily: 'Inter_600SemiBold', textDecorationLine: 'underline' }}>Privacy Policy</Text>
              </TouchableOpacity>
            </View>
          </View>
        ) : (
          <Text style={{ textAlign: 'center', fontSize: 10, color: colors.textDim, marginTop: 24, fontFamily: 'Inter_400Regular' }}>
            Secure payment via Razorpay
          </Text>
        )}
        {IS_IOS ? (
          <TouchableOpacity onPress={handleRestore} disabled={paying} style={{ marginTop: 12, alignItems: 'center' }}>
            <Text style={{ fontSize: 13, color: colors.primary, fontFamily: 'Inter_600SemiBold' }}>Restore purchases</Text>
          </TouchableOpacity>
        ) : null}
      </ScrollView>
    </SafeAreaView>
  );
}
