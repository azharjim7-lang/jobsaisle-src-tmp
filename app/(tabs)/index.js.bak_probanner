  }, []);
  const posted = job.postedDate ? (() => {
    const days = Math.floor((Date.now() - new Date(job.postedDate).getTime()) / 86400000);
    if (days < 1) return 'Today';
    if (days === 1) return '1d ago';
    if (days < 7) return days + 'd ago';
    if (days < 30) return Math.floor(days / 7) + 'w ago';
    return Math.floor(days / 30) + 'mo ago';
  })() : '';
  const hasSalary = job.salaryDisplay && job.salaryDisplay !== 'Competitive';
  const meta = [job.city, job.jobType, posted].filter(Boolean).join('  \u00B7  ');
  return (
    <Animated.View style={{ opacity: enter, transform: [{ scale }, { translateY: enter.interpolate({ inputRange: [0, 1], outputRange: [10, 0] }) }] }}>
      <TouchableOpacity
        onPress={onPress}
        activeOpacity={1}
        onPressIn={() => Animated.spring(scale, { toValue: 0.975, useNativeDriver: true, speed: 40, bounciness: 0 }).start()}
        onPressOut={() => Animated.spring(scale, { toValue: 1, useNativeDriver: true, speed: 30, bounciness: 6 }).start()}
        style={{
          width: wide ? 268 : '100%',
          height: wide ? 172 : undefined,
          backgroundColor: colors.card,
          borderRadius: 16,
          padding: 16,
          marginBottom: 10,
          marginRight: wide ? 10 : 0,
          shadowColor: '#0D2E23',
          shadowOpacity: 0.06,
          shadowRadius: 12,
          shadowOffset: { width: 0, height: 3 },
          elevation: 2,
        }}>
        <View style={{ flexDirection: 'row', gap: 12, alignItems: 'flex-start' }}>
          <View style={{ width: 44, height: 44, borderRadius: 12, backgroundColor: bg, alignItems: 'center', justifyContent: 'center' }}>
            <Text style={{ fontSize: 17, fontFamily: 'Inter_600SemiBold', color: fg }}>{ci}</Text>
          </View>
