      </TouchableOpacity>
    </Animated.View>
  );
}

function SkeletonCard() {
  const pulse = useRef(new Animated.Value(0.4)).current;
  useEffect(() => {
    const loop = Animated.loop(Animated.sequence([
      Animated.timing(pulse, { toValue: 1, duration: 700, easing: Easing.inOut(Easing.ease), useNativeDriver: true }),
      Animated.timing(pulse, { toValue: 0.4, duration: 700, easing: Easing.inOut(Easing.ease), useNativeDriver: true }),
    ]));
    loop.start();
    return () => loop.stop();
  }, []);
  const Bar = ({ w, h = 12, mt = 0 }) => (
    <Animated.View style={{ width: w, height: h, borderRadius: 6, backgroundColor: colors.cardBorder, opacity: pulse, marginTop: mt }} />
  );
  return (
    <View style={{ backgroundColor: colors.card, borderRadius: 16, padding: 16, marginBottom: 10 }}>
      <View style={{ flexDirection: 'row', gap: 12 }}>
        <Animated.View style={{ width: 44, height: 44, borderRadius: 12, backgroundColor: colors.cardBorder, opacity: pulse }} />
