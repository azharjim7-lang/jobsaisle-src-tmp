                  <Text style={{ fontSize: 10, color: colors.text, fontFamily: 'Inter_700Bold', letterSpacing: 0.4 }}>{p.tag}</Text>
                </View>
              </View>
              <View style={{ padding: 11 }}>
                <Text numberOfLines={2} style={{ fontSize: 11, color: colors.text, fontFamily: 'Inter_600SemiBold', lineHeight: 14 }}>{p.title}</Text>
                <Text style={{ fontSize: 11, color: colors.textDim, marginTop: 5, fontFamily: 'Inter_400Regular' }}>{p.read}</Text>
              </View>
            </TouchableOpacity>
          ))}
        </ScrollView>
      </ScrollView>
    </SafeAreaView>
  );
}
