import { useState, useEffect, useCallback } from 'react';
import { View, Text, ScrollView, TouchableOpacity, FlatList, ActivityIndicator, Image, RefreshControl } from 'react-native';
import { SafeAreaView, useSafeAreaInsets } from 'react-native-safe-area-context';
import { useRouter, useFocusEffect } from 'expo-router';
import AsyncStorage from '@react-native-async-storage/async-storage';
import * as WebBrowser from 'expo-web-browser';
import { colors } from '../../lib/colors';
import { fetchJobs, fetchSimilarJobs } from '../../lib/api';
import { detectLocation } from '../../lib/geo';
import { fetchProfile, profileCompletion } from '../../lib/profile';
import { getApplied, getAlerts } from '../../lib/storage';
import { getMyApplications } from '../../lib/api';

const COMPANY_COLORS = [
  ['rgba(99,102,241,0.18)', '#818cf8'],
  ['rgba(244,114,182,0.18)', '#f472b6'],
  ['rgba(56,189,248,0.18)', '#38bdf8'],
  ['rgba(52,211,153,0.18)', '#34D399'],
  ['rgba(251,146,60,0.18)', '#fb923c'],
  ['rgba(168,85,247,0.18)', '#a855f7'],
];

function colorForCompany(name) {
  if (!name) return COMPANY_COLORS[0];
  let hash = 0;
  for (let i = 0; i < name.length; i++) hash = (hash * 31 + name.charCodeAt(i)) | 0;
  return COMPANY_COLORS[Math.abs(hash) % COMPANY_COLORS.length];
}

function formatSalary(min, max) {
  if (!min && !max) return null;
  const fmt = (n) => {
    if (!n) return '';
    if (n >= 100000) return '₹' + Math.round(n / 1000) + 'K';
    return '₹' + n;
  };
  if (min && max) return fmt(min) + '–' + fmt(max);
  return fmt(min || max) + '+';
}

function timeAgo(dateStr) {
  if (!dateStr) return '';
  const ms = Date.now() - new Date(dateStr).getTime();
  const hours = Math.floor(ms / 3600000);
  const d = Math.floor(ms / 86400000);
  if (hours < 1) return 'just now';
  if (hours < 24) return hours + 'h ago';
  if (d === 1) return '1 day ago';
  if (d < 7) return d + ' days ago';
  if (d < 14) return '1 week ago';
  if (d < 30) return Math.floor(d / 7) + ' weeks ago';
  if (d < 60) return '1 month ago';
  return Math.floor(d / 30) + ' months ago';
}

export default function HomeScreen() {
  const router = useRouter();
  const insets = useSafeAreaInsets();
  const [user, setUser] = useState(null);
  const [profile, setProfile] = useState(null);
  const [city, setCity] = useState('');
  const [country, setCountry] = useState('');
  const [appliesBased, setAppliesBased] = useState([]);
  const [profileBased, setProfileBased] = useState([]);
  const [industries, setIndustries] = useState([]);
  const [industriesRoleApplied, setIndustriesRoleApplied] = useState(false);
  const [industriesRoleLabel, setIndustriesRoleLabel] = useState(null);
  const [cityJobs, setCityJobs] = useState([]);
  const [topCompanies, setTopCompanies] = useState([]);
  const [appliedCount, setAppliedCount] = useState(0);
  const [refreshing, setRefreshing] = useState(false);
  const [refreshKey, setRefreshKey] = useState(0);
  const onRefresh = () => { setRefreshing(true); setRefreshKey(k => k + 1); };
  const [alertCount, setAlertCount] = useState(0);
  const [loading, setLoading] = useState(true);

  const completion = profileCompletion(profile);

  useFocusEffect(useCallback(() => {
    let cancelled = false;
    (async () => { try {
      // Load user + profile + counts
      const u = await AsyncStorage.getItem('user');
      const parsed = u ? JSON.parse(u) : null;
      if (cancelled) return;
      setUser(parsed);
      if (parsed) {
        const p = await fetchProfile(parsed.uid);
        if (!cancelled) setProfile(p);
      }
      // Only load applied/alerts data when logged in
      let applied = [];
      let alerts = [];
      if (parsed) {
        // Load local immediately for fast render
        const [localApplied, alertsList] = await Promise.all([getApplied(), getAlerts()]);
        alerts = alertsList;
        applied = localApplied;
        // Kick off server fetch in background — don't block render
        if (parsed?.uid) {
          getMyApplications(parsed.uid).then(serverApps => {
            if (cancelled || !Array.isArray(serverApps)) return;
            // Merge server + local, update count
            const byId = new Map();
            for (const s of serverApps) {
              byId.set(s.jobId, { id: s.jobId, title: s.jobTitle, company: s.company || s.jobCompany, appliedAt: new Date(s.createdAt).getTime() });
            }
            for (const l of localApplied) {
              if (!byId.has(l.id)) byId.set(l.id, l);
            }
            const merged = [...byId.values()];
            setAppliedCount(merged.length);
          }).catch(e => console.log('[home] server apps bg fetch failed:', e?.message));
        }
      }
      if (cancelled) return;
      setAppliedCount(applied.length);
      setAlertCount(alerts.length);

      // Geo (defensive)
      let loc = null;
      try { loc = await detectLocation(); } catch (e) { console.log('[home] detectLocation threw:', e?.message); }
      if (cancelled) return;
      if (loc?.country) setCountry(loc.country);
      // NOTE: don't setCity(loc.city) here — it'll be set AFTER preferredCity override so heading matches card content
      let useCity = loc?.city || 'Delhi';
      let primaryCity = useCity;
      const useCountry = loc?.country || 'India';
      console.log('[home] geo resolved:', { useCity, useCountry });

      // Get profile + apply preferredCity override FIRST
      const profileForSignals = parsed ? await fetchProfile(parsed.uid) : null;
      const preferredCity = profileForSignals?.preferredCities?.[0];
      if (preferredCity) {
        useCity = preferredCity;
        primaryCity = preferredCity;
      }
      // Update visible city heading to match what we're actually fetching
      setCity(useCity);
      // Build user signals using the FINAL useCity (Mumbai if user prefers Mumbai)
      const userSignals = {
        uid: parsed?.uid,
        currentTitle: profileForSignals?.currentTitle,
        skills: profileForSignals?.skills,
        city: useCity,
        country: useCountry,
        preferredCities: profileForSignals?.preferredCities,
      };

      // === Trending FIRST so we can exclude its IDs from "Jobs in city" ===
      let trendingJobs = [];
      try {
        let featured = await fetchJobs({ city: useCity, country: loc?.country || 'India', sort: 'newest', user: userSignals, limit: 8, exclude_applied: userSignals?.uid ? 1 : undefined });
        if (!featured?.jobs || featured.jobs.length < 3) {
          const fb = await fetchJobs({ country: loc?.country || 'India', sort: 'newest', user: userSignals, limit: 8, exclude_applied: userSignals?.uid ? 1 : undefined });
          if (fb?.jobs?.length) featured = fb;
        }
        trendingJobs = featured?.jobs || [];
        if (!cancelled) setAppliesBased(trendingJobs);
      } catch {}

      // Excluded IDs so Jobs in city shows DIFFERENT jobs
      const excludeIds = trendingJobs.map(j => j.id).filter(Boolean);

      // Jobs in city — with country-level fallback if city has < 3 results
      try {
        let cityResults = await fetchJobs({ city: useCity, country: loc?.country || 'India', user: userSignals, sort: 'newest', limit: 8, exclude: excludeIds, exclude_applied: userSignals?.uid ? 1 : undefined });
        let usedCityLabel = useCity;
        if (!cityResults?.jobs || cityResults.jobs.length < 3) {
          // Fall back to country-level when city has too few jobs
          const fallback = await fetchJobs({ country: loc?.country || 'India', user: userSignals, sort: 'newest', limit: 8, exclude_applied: userSignals?.uid ? 1 : undefined });
          if (fallback?.jobs?.length) {
            cityResults = fallback;
            usedCityLabel = loc?.country || 'India';
          }
        }
        if (!cancelled) {
          setCityJobs(cityResults?.jobs || []);
          // Update displayed city label so section header reflects what was actually queried
          if (usedCityLabel !== useCity) setCity(usedCityLabel);
        }
      } catch (e) {}

      // Based on applies
      if (applied.length > 0) {
        try {
          const lastApplied = applied[0];
          const userCountry = profileForSignals?.country || loc?.country || 'India';
          const userCities = profileForSignals?.preferredCities || [];
          const primaryCity = userCities[0] || loc?.city;
          
          // Extract primary keyword: first 1-2 significant words from title
          // (skip filler like "Senior", "Junior", "Lead", etc. and stop at delimiters)
          const skipWords = new Set(['senior','junior','sr','jr','lead','head','principal','associate','assistant','staff','executive','officer','intern','trainee','entry','level','&','and','-','/']);
          const titleWords = (lastApplied?.title || '')
            .replace(/[|\-\/&,()]/g, ' ')
            .split(/\s+/)
            .filter(w => w && w.length >= 3 && !skipWords.has(w.toLowerCase()));
          const searchKey = titleWords.slice(0, 2).join(' ') || (profileForSignals?.currentTitle || '');
          
          // Try city-specific first
          let simJobs = [];
          if (primaryCity && searchKey) {
            const r1 = await fetchJobs({ search: searchKey, country: userCountry, city: primaryCity, sort: 'newest', limit: 6, exclude_applied: userSignals?.uid ? 1 : undefined });
            simJobs = r1?.jobs || [];
          }
          // Fallback 1: country only
          if (simJobs.length < 3 && searchKey) {
            const r2 = await fetchJobs({ search: searchKey, country: userCountry, sort: 'newest', limit: 6, exclude_applied: userSignals?.uid ? 1 : undefined });
            simJobs = r2?.jobs || [];
          }
          // Fallback 2: profile title
          if (simJobs.length < 3 && profileForSignals?.currentTitle && profileForSignals.currentTitle !== searchKey) {
            const r3 = await fetchJobs({ search: profileForSignals.currentTitle, country: userCountry, sort: 'newest', limit: 6, exclude_applied: userSignals?.uid ? 1 : undefined });
            simJobs = r3?.jobs || [];
          }
          // Fallback 3: featured jobs in country
          if (simJobs.length < 3) {
            const r4 = await fetchJobs({ country: userCountry, type: 'trending', limit: 8 });
            simJobs = r4?.jobs || [];
          }
          if (!cancelled && simJobs.length > 0) setAppliesBased(simJobs);
          // If simJobs empty, keep whatever was set earlier (trendingJobs fallback)
        } catch {
          // Don't wipe existing state on error
        }
      }
      

      // Industries hiring now (replaces "Based on your profile")
      try {
        const params = new URLSearchParams();
        params.set('country', loc?.country || 'India');
        if (loc?.city) params.set('city', loc.city);
        if (profileForSignals?.currentTitle) params.set('user_title', profileForSignals.currentTitle);
        if (profileForSignals?.skills?.length) params.set('user_skills', profileForSignals.skills.slice(0, 5).join(','));
        params.set('limit', 8);
        let data = null;
        try {
          const resp = await fetch('https://www.jobsaisle.com/api/industries?' + params);
          data = await resp.json();
        } catch {}
        // Fallback: if city returned too few, retry country-only
        if (!data?.industries || data.industries.length < 3) {
          const fbParams = new URLSearchParams();
          fbParams.set('country', loc?.country || 'India');
          if (profileForSignals?.currentTitle) fbParams.set('user_title', profileForSignals.currentTitle);
          if (profileForSignals?.skills?.length) fbParams.set('user_skills', profileForSignals.skills.slice(0, 5).join(','));
          fbParams.set('limit', 8);
          try {
            const fb = await fetch('https://www.jobsaisle.com/api/industries?' + fbParams);
            const fbData = await fb.json();
            if (fbData?.industries?.length) data = fbData;
          } catch {}
        }
        if (!cancelled) {
          setIndustries(data?.industries || []);
          setIndustriesRoleApplied(!!data?.roleApplied);
          setIndustriesRoleLabel(data?.roleLabel || null);
        }
      } catch (e) {
        if (!cancelled) setIndustries([]);
      }

            // Top companies — derive from city jobs
      try {
        const counts = {};
        (cityJobs || []).slice(0, 50).forEach(j => {
          if (j.company) counts[j.company] = (counts[j.company] || 0) + 1;
        });
        const top = Object.entries(counts).sort((a, b) => b[1] - a[1]).slice(0, 8).map(([name, count]) => ({ name, count }));
        if (!cancelled) setTopCompanies(top);
      } catch {}

      if (!cancelled) setLoading(false);
      setRefreshing(false);
    } catch (e) { console.log('[home] effect crashed:', e?.message, e?.stack); if (!cancelled) setLoading(false); } })();
    return () => { cancelled = true; };
  }, [refreshKey]));

  // ============ Render helpers ============
  const initials = (user?.name || user?.email || 'U').split(' ').map(w => w[0]).join('').slice(0, 2).toUpperCase();

  const JobCard = ({ job, wide }) => {
    const [bg, fg] = colorForCompany(job.company);
    const ci = (job.company || '?')[0]?.toUpperCase();
    const posted = job.postedDate ? (() => {
      const days = Math.floor((Date.now() - new Date(job.postedDate).getTime()) / 86400000);
      if (days < 1) return 'Today';
      if (days === 1) return '1d ago';
      if (days < 7) return days + 'd ago';
      if (days < 30) return Math.floor(days / 7) + 'w ago';
      return Math.floor(days / 30) + 'mo ago';
    })() : '';
    const hasSalary = job.salaryDisplay && job.salaryDisplay !== 'Competitive';
    return (
      <TouchableOpacity
        onPress={() => router.push('/job/' + (job.slug || job.id))}
        activeOpacity={0.7}
        style={{
          width: wide ? 240 : '100%',
          backgroundColor: colors.card,
          borderWidth: 0.5,
          borderColor: colors.cardBorder,
          borderRadius: 14,
          padding: 14,
          marginBottom: 10,
          marginRight: wide ? 8 : 0,
        }}>
        <View style={{ flexDirection: 'row', gap: 12, alignItems: 'flex-start' }}>
          <View style={{ width: 40, height: 40, borderRadius: 10, backgroundColor: bg, alignItems: 'center', justifyContent: 'center' }}>
            <Text style={{ fontSize: 15, fontFamily: 'DMSans_700Bold', color: fg }}>{ci}</Text>
          </View>
          <View style={{ flex: 1, minWidth: 0 }}>
            <View style={{ flexDirection: 'row', alignItems: 'flex-start', gap: 8 }}>
              <Text style={{ flex: 1, fontSize: 14, fontFamily: 'DMSans_700Bold', color: colors.text, lineHeight: 18 }} numberOfLines={2}>
                {job.title}
              </Text>
              {posted ? (
                <Text style={{ fontSize: 10, color: colors.textDim, fontFamily: 'DMSans_400Regular', marginTop: 2 }}>{posted}</Text>
              ) : null}
            </View>
            <Text style={{ fontSize: 12, color: colors.textMuted, marginTop: 3, fontFamily: 'DMSans_500Medium' }} numberOfLines={1}>
              {job.company}{job.city ? ' · ' + job.city : ''}
            </Text>
          </View>
        </View>
        <View style={{ flexDirection: 'row', flexWrap: 'wrap', gap: 6, marginTop: 12, alignItems: 'center' }}>
          {hasSalary ? (
            <View style={{ backgroundColor: 'rgba(52,211,153,0.15)', paddingHorizontal: 9, paddingVertical: 4, borderRadius: 6 }}>
              <Text style={{ fontSize: 11, color: colors.primary, fontFamily: 'DMSans_700Bold' }}>{job.salaryDisplay}</Text>
            </View>
          ) : null}
          {job.jobType ? (
            <Text style={{ fontSize: 10, color: colors.textMuted, backgroundColor: colors.card, paddingHorizontal: 9, paddingVertical: 4, borderRadius: 6, fontFamily: 'DMSans_500Medium', overflow: 'hidden' }}>{job.jobType}</Text>
          ) : null}
        </View>
      </TouchableOpacity>
    );
  };

  const SectionHeader = ({ title, subtitle, onPress, linkText }) => (
    <View style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-start', paddingHorizontal: 16, marginTop: 18, marginBottom: 10 }}>
      <View style={{ flex: 1 }}>
        <Text style={{ fontSize: 14, color: colors.text, fontFamily: 'DMSans_700Bold' }}>{title}</Text>
        {subtitle ? <Text style={{ fontSize: 10, color: colors.textDim, marginTop: 2, fontFamily: 'DMSans_400Regular' }}>{subtitle}</Text> : null}
      </View>
      {onPress ? (
        <TouchableOpacity onPress={onPress}>
          <Text style={{ fontSize: 11, color: colors.primary, fontFamily: 'DMSans_600SemiBold' }}>{linkText || 'View all →'}</Text>
        </TouchableOpacity>
      ) : null}
    </View>
  );

  if (loading && cityJobs.length === 0) {
    return (
      <SafeAreaView style={{ flex: 1, backgroundColor: colors.bg, alignItems: 'center', justifyContent: 'center' }}>
        <ActivityIndicator color={colors.primary} />
      </SafeAreaView>
    );
  }

  return (
    <SafeAreaView style={{ flex: 1, backgroundColor: colors.bg }} edges={['top']}>
      <ScrollView contentContainerStyle={{ paddingBottom: 24 + insets.bottom }} showsVerticalScrollIndicator={false} refreshControl={<RefreshControl refreshing={refreshing} onRefresh={onRefresh} tintColor="#0D9373" colors={["#0D9373"]} />}>

        {/* Top bar — menu, search, alerts in one row */}
        <View style={{ flexDirection: 'row', alignItems: 'center', paddingHorizontal: 14, paddingTop: 10, paddingBottom: 4, gap: 8 }}>
          <TouchableOpacity onPress={() => router.push('/menu')} style={{ width: 36, height: 36, alignItems: 'center', justifyContent: 'center' }}>
            <Text style={{ fontSize: 19, color: colors.textMuted }}>☰</Text>
          </TouchableOpacity>
          <TouchableOpacity onPress={() => router.push('/(tabs)/search')} activeOpacity={0.85} style={{ flex: 1, backgroundColor: colors.inputBg, borderWidth: 0.5, borderColor: colors.inputBorder, borderRadius: 8, paddingHorizontal: 10, paddingVertical: 7, flexDirection: 'row', alignItems: 'center', gap: 6 }}>
            <Text style={{ fontSize: 12 }}>🔍</Text>
            <Text style={{ flex: 1, fontSize: 12, color: colors.textDim, fontFamily: 'DMSans_400Regular' }}>Search jobs…</Text>
          </TouchableOpacity>
          <TouchableOpacity onPress={() => router.push('/notifications')} style={{ width: 36, height: 36, alignItems: 'center', justifyContent: 'center' }}>
            <Text style={{ fontSize: 17 }}>🔔</Text>
          </TouchableOpacity>
        </View>

        {/* Profile + Applications */}
        {user ? (
          <View style={{ flexDirection: 'row', gap: 8, paddingHorizontal: 16, marginBottom: 8 }}>
            <TouchableOpacity onPress={() => router.push(completion < 100 ? '/profile-setup' : '/(tabs)/profile')} activeOpacity={0.85} style={{ flex: 1, backgroundColor: colors.card, borderWidth: 0.5, borderColor: colors.cardBorder, borderRadius: 12, padding: 11, flexDirection: 'row', alignItems: 'center', gap: 9 }}>
              <View style={{ position: 'relative', width: 40, height: 40 }}>
                <View style={{ width: 40, height: 40, borderRadius: 20, backgroundColor: colors.primary, alignItems: 'center', justifyContent: 'center' }}>
                  <Text style={{ fontSize: 14, color: '#FFFFFF', fontFamily: 'DMSans_700Bold' }}>{initials}</Text>
                </View>
                <View style={{ position: 'absolute', bottom: -2, right: -4, backgroundColor: completion === 100 ? colors.primary : colors.gold, paddingHorizontal: 5, paddingVertical: 1, borderRadius: 5, borderWidth: 1.5, borderColor: colors.bg }}>
                  <Text style={{ fontSize: 8, color: '#FFFFFF', fontFamily: 'DMSans_700Bold' }}>{completion}%</Text>
                </View>
              </View>
              <View style={{ flex: 1, minWidth: 0 }}>
                <Text numberOfLines={1} style={{ fontSize: 12, color: colors.text, fontFamily: 'DMSans_700Bold' }}>{user.name || 'Your profile'}</Text>
                <Text style={{ fontSize: 9, color: colors.textDim, marginTop: 1, fontFamily: 'DMSans_400Regular' }}>{completion < 100 ? 'Complete +' + (100 - completion) + '%' : 'Complete'}</Text>
                <Text style={{ fontSize: 10, color: colors.primary, marginTop: 4, fontFamily: 'DMSans_700Bold' }}>{completion < 100 ? 'Complete now' : 'View profile'}</Text>
              </View>
            </TouchableOpacity>
            <TouchableOpacity onPress={() => router.push('/applied')} activeOpacity={0.85} style={{ flex: 1, backgroundColor: colors.card, borderWidth: 0.5, borderColor: colors.cardBorder, borderRadius: 12, padding: 11 }}>
              <Text style={{ fontSize: 18, color: colors.text, fontFamily: 'DMSans_700Bold' }}>{appliedCount}</Text>
              <Text style={{ fontSize: 9, color: colors.textDim, marginTop: 1, fontFamily: 'DMSans_400Regular' }}>Applications</Text>
              <Text style={{ fontSize: 10, color: colors.primary, marginTop: 6, fontFamily: 'DMSans_700Bold' }}>View all</Text>
            </TouchableOpacity>
          </View>
        ) : null}

        {/* Job alerts opt-in */}
        {alertCount === 0 ? (
          <TouchableOpacity onPress={() => router.push('/alerts')} activeOpacity={0.85} style={{ marginHorizontal: 16, marginTop: 8, padding: 12, backgroundColor: 'rgba(226,192,110,0.06)', borderWidth: 0.5, borderColor: 'rgba(226,192,110,0.2)', borderRadius: 12, flexDirection: 'row', alignItems: 'center', gap: 11 }}>
            <View style={{ width: 36, height: 36, borderRadius: 9, backgroundColor: 'rgba(226,192,110,0.15)', alignItems: 'center', justifyContent: 'center' }}>
              <Text style={{ fontSize: 16 }}>🔔</Text>
            </View>
            <View style={{ flex: 1, minWidth: 0 }}>
              <Text style={{ fontSize: 12, color: colors.text, fontFamily: 'DMSans_600SemiBold' }}>Get instant job alerts</Text>
              <Text style={{ fontSize: 10, color: colors.textMuted, marginTop: 1, fontFamily: 'DMSans_400Regular' }}>Save searches, never miss a match</Text>
            </View>
            <View style={{ backgroundColor: colors.gold, paddingHorizontal: 10, paddingVertical: 6, borderRadius: 7 }}>
              <Text style={{ fontSize: 10, color: '#FFFFFF', fontFamily: 'DMSans_700Bold' }}>Set up</Text>
            </View>
          </TouchableOpacity>
        ) : null}

        {/* Complete profile for better matches — only when logged in + incomplete */}
        {(!user || completion < 100) ? (
          <TouchableOpacity 
            onPress={() => router.push(user ? '/profile-setup' : '/auth')} 
            activeOpacity={0.85} 
            style={{ marginHorizontal: 16, marginTop: 8, backgroundColor: 'rgba(226,192,110,0.08)', borderWidth: 0.5, borderColor: 'rgba(226,192,110,0.25)', borderRadius: 12, paddingHorizontal: 12, paddingVertical: 11, flexDirection: 'row', alignItems: 'center', gap: 11 }}>
            <View style={{ width: 36, height: 36, borderRadius: 9, backgroundColor: 'rgba(226,192,110,0.15)', alignItems: 'center', justifyContent: 'center' }}>
              <Text style={{ fontSize: 16 }}>📝</Text>
            </View>
            <View style={{ flex: 1, minWidth: 0 }}>
              <Text style={{ fontSize: 12, color: colors.text, fontFamily: 'DMSans_600SemiBold' }}>{user ? 'Complete your profile' : 'Create your profile'}</Text>
              <Text numberOfLines={1} style={{ fontSize: 11, color: colors.textMuted, marginTop: 2, fontFamily: 'DMSans_400Regular' }}>{user ? completion + '% done — better matches with full profile' : 'Sign up for personalized job matches'}</Text>
            </View>
            <Text style={{ fontSize: 14, color: colors.gold || '#E2C06E', fontFamily: 'DMSans_700Bold' }}>→</Text>
          </TouchableOpacity>
        ) : null}

        {/* Based on your applies / Trending in city */}
        {appliesBased.length > 0 ? (
          <>
            <SectionHeader
              title={
                !user ? (city ? 'Trending in ' + city : 'Trending jobs') :
                appliedCount > 0 ? 'Based on your applies' :
                'Recommended for you'
              }
              subtitle={
                !user ? 'Popular roles right now' :
                appliedCount > 0 ? 'Similar to roles you\'ve applied to' :
                'Based on your location'
              }
              onPress={() => {
                // Pass role keyword + city to search
                const lastApplied = appliedCount > 0 && appliesBased[0] ? appliesBased[0] : null;
                const skipWords = new Set(['senior','junior','sr','jr','lead','head','principal','associate','assistant','staff','executive','officer','intern','trainee','&','and']);
                const titleSrc = lastApplied?.title || profile?.currentTitle || '';
                const titleWords = titleSrc.replace(/[|\-\/&,()]/g, ' ').split(/\s+/).filter(w => w && w.length >= 3 && !skipWords.has(w.toLowerCase()));
                const query = titleWords.slice(0, 2).join(' ');
                router.push({ pathname: '/(tabs)/search', params: { query, city: profile?.preferredCities?.[0] || city } });
              }}
            />
            <FlatList
              horizontal
              data={appliesBased.slice(0, 8)}
              keyExtractor={(j) => 'a-' + (j.id || j.slug)}
              renderItem={({ item }) => <JobCard job={item} wide />}
              showsHorizontalScrollIndicator={false}
              contentContainerStyle={{ paddingHorizontal: 16 }}
            />
          </>
        ) : null}

        {/* PRO BANNER — recruiter contacts */}
        <TouchableOpacity onPress={() => router.push('/(tabs)/pro')} activeOpacity={0.9} style={{ marginHorizontal: 16, marginTop: 18, backgroundColor: '#0D2E23', borderWidth: 0.5, borderColor: 'rgba(226,192,110,0.25)', borderRadius: 14, padding: 14 }}>
          <View style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', marginBottom: 10 }}>
            <Text style={{ fontSize: 9, color: colors.gold, letterSpacing: 1.4, fontFamily: 'DMSans_700Bold' }}>✦ JOBSAISLE PRO</Text>
            <Text style={{ fontSize: 10, color: colors.textDim, fontFamily: 'DMSans_400Regular' }}>From ₹199/mo</Text>
          </View>
          <Text style={{ fontSize: 14, color: colors.text, fontFamily: 'DMSans_700Bold', marginBottom: 4 }}>Get the recruiter's email for any job</Text>
          <Text style={{ fontSize: 11, color: colors.textMuted, lineHeight: 15, marginBottom: 12, fontFamily: 'DMSans_400Regular' }}>16K+ verified hiring manager contacts. Skip the application black hole — message them directly.</Text>
          {/* Mock recruiter card */}
          <View style={{ backgroundColor: 'rgba(52,211,153,0.06)', borderWidth: 0.5, borderColor: 'rgba(52,211,153,0.18)', borderRadius: 10, padding: 10, marginBottom: 12 }}>
            <View style={{ flexDirection: 'row', alignItems: 'center', gap: 9 }}>
              <View style={{ width: 30, height: 30, borderRadius: 15, backgroundColor: colors.card, alignItems: 'center', justifyContent: 'center' }}>
                <Text style={{ fontSize: 11, color: colors.text, fontFamily: 'DMSans_700Bold' }}>PS</Text>
              </View>
              <View style={{ flex: 1, minWidth: 0 }}>
                <Text numberOfLines={1} style={{ fontSize: 11, color: colors.text, fontFamily: 'DMSans_600SemiBold' }}>Priya Sharma</Text>
                <Text style={{ fontSize: 9, color: colors.textMuted, fontFamily: 'DMSans_400Regular' }}>Sr. Talent Lead · Razorpay</Text>
              </View>
              <View style={{ backgroundColor: 'rgba(226,192,110,0.15)', paddingHorizontal: 7, paddingVertical: 3, borderRadius: 5 }}>
                <Text style={{ fontSize: 8, color: colors.gold, fontFamily: 'DMSans_700Bold' }}>PRO</Text>
              </View>
            </View>
            <View style={{ flexDirection: 'row', alignItems: 'center', gap: 5, marginTop: 8, paddingTop: 8, borderTopWidth: 0.5, borderTopColor: colors.cardBorder }}>
              <Text style={{ fontSize: 11, color: colors.textMuted, fontFamily: 'DMSans_400Regular' }}>priya.sharma@</Text>
              <Text style={{ fontSize: 11, color: colors.textDim, letterSpacing: 1, fontFamily: 'DMSans_400Regular' }}>•••••••••••</Text>
            </View>
          </View>
          <View style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
            <View style={{ flex: 1, backgroundColor: colors.primary, paddingVertical: 10, borderRadius: 9, alignItems: 'center' }}>
              <Text style={{ fontSize: 12, color: '#FFFFFF', fontFamily: 'DMSans_700Bold' }}>Unlock contacts →</Text>
            </View>
            <Text style={{ fontSize: 10, color: colors.textDim, paddingHorizontal: 4, fontFamily: 'DMSans_400Regular' }}>7-day trial</Text>
          </View>
        </TouchableOpacity>

        {/* Industries hiring now (replaces "Based on your profile") */}
        {industries.length > 0 ? (
          <>
            <SectionHeader
              title={profile?.currentTitle || (profile?.skills && profile.skills.length > 0) ? 'Industries for you' : 'Industries hiring now'}
              subtitle={profile?.currentTitle ? 'Tailored to your role & skills' : 'Top categories in ' + city}
              onPress={() => {
                // If user has a role, search by it; otherwise show all in city
                if (profile?.currentTitle) {
                  router.push({ pathname: '/(tabs)/search', params: { query: profile.currentTitle, city: profile?.preferredCities?.[0] || city } });
                } else {
                  router.push({ pathname: '/(tabs)/search', params: { city } });
                }
              }}
            />
            <FlatList
              horizontal
              data={industries}
              keyExtractor={(it) => 'ind-' + it.id}
              renderItem={({ item }) => (
                <TouchableOpacity
                  onPress={() => router.push({ 
                    pathname: '/(tabs)/search', 
                    params: { 
                      sector: item.id, 
                      query: industriesRoleLabel || '' 
                    } 
                  })}
                  activeOpacity={0.85}
                  style={{ width: 220, marginRight: 10, backgroundColor: colors.card, borderWidth: 0.5, borderColor: colors.cardBorder, borderRadius: 12, padding: 13 }}>
                  <View style={{ flexDirection: 'row', alignItems: 'center', gap: 8, marginBottom: 8 }}>
                    <Text style={{ fontSize: 22 }}>{item.icon}</Text>
                    <View style={{ flex: 1 }}>
                      <Text numberOfLines={1} style={{ fontSize: 13, color: colors.text, fontFamily: 'DMSans_700Bold' }}>{item.label}</Text>
                      <Text numberOfLines={1} style={{ fontSize: 10, color: colors.primary, marginTop: 1, fontFamily: 'DMSans_500Medium' }}>
                        {item.jobCount.toLocaleString()} {industriesRoleApplied && industriesRoleLabel ? industriesRoleLabel + ' jobs' : 'jobs'}
                      </Text>
                    </View>
                  </View>
                  <Text numberOfLines={2} style={{ fontSize: 10, color: colors.textMuted, lineHeight: 14, fontFamily: 'DMSans_400Regular', minHeight: 28 }}>
                    {(item.topCompanies || []).slice(0, 4).map(c => industriesRoleApplied ? c.name + ' (' + c.jobCount + ')' : c.name).join(' · ')}
                  </Text>
                  <Text style={{ fontSize: 9, color: colors.textDim, marginTop: 4, fontFamily: 'DMSans_400Regular' }}>{item.companyCount} companies hiring</Text>
                </TouchableOpacity>
              )}
              showsHorizontalScrollIndicator={false}
              contentContainerStyle={{ paddingHorizontal: 16 }}
            />

          </>
        ) : null}

        {/* Jobs in [city] */}
        {cityJobs.length > 0 ? (
          <>
            <SectionHeader
              title={profile?.currentTitle ? 'Top matches for you' : 'Jobs in ' + city}
              subtitle={profile?.currentTitle ? 'Ranked by your title, skills and location' : (cityJobs.length + '+ active in your area')}
              onPress={() => router.push({ pathname: '/(tabs)/search', params: { city } })}
            />
            <FlatList
              horizontal
              data={cityJobs.slice(0, 10)}
              keyExtractor={(j) => 'c-' + (j.id || j.slug)}
              renderItem={({ item }) => <JobCard job={item} wide />}
              showsHorizontalScrollIndicator={false}
              contentContainerStyle={{ paddingHorizontal: 16 }}
            />
          </>
        ) : null}

        {/* Explore more jobs tiles */}
        <View style={{ flexDirection: 'row', gap: 8, paddingHorizontal: 16, marginTop: 18 }}>
          <TouchableOpacity onPress={() => router.push({ pathname: '/jobs-list', params: { type: 'featured' } })} activeOpacity={0.85} style={{ flex: 1, backgroundColor: 'rgba(56,189,248,0.06)', borderWidth: 0.5, borderColor: 'rgba(56,189,248,0.2)', borderRadius: 12, padding: 13 }}>
            <Text style={{ fontSize: 18, marginBottom: 6 }}>🎯</Text>
            <Text style={{ fontSize: 12, color: colors.text, fontFamily: 'DMSans_700Bold' }}>Featured</Text>
            <Text style={{ fontSize: 10, color: colors.textDim, marginTop: 2, fontFamily: 'DMSans_400Regular' }}>Hand-picked roles</Text>
          </TouchableOpacity>
          <TouchableOpacity onPress={() => router.push({ pathname: '/jobs-list', params: { type: 'fresh' } })} activeOpacity={0.85} style={{ flex: 1, backgroundColor: 'rgba(226,192,110,0.06)', borderWidth: 0.5, borderColor: 'rgba(226,192,110,0.2)', borderRadius: 12, padding: 13 }}>
            <Text style={{ fontSize: 18, marginBottom: 6 }}>⚡</Text>
            <Text style={{ fontSize: 12, color: colors.text, fontFamily: 'DMSans_700Bold' }}>Hiring fast</Text>
            <Text style={{ fontSize: 10, color: colors.textDim, marginTop: 2, fontFamily: 'DMSans_400Regular' }}>Posted today</Text>
          </TouchableOpacity>
        </View>

        {/* Top companies hiring */}
        {topCompanies.length > 0 ? (
          <>
            <SectionHeader
              title="Top companies hiring"
              subtitle={'In ' + city}
              onPress={() => router.push('/(tabs)/search')}
            />
            <FlatList
              horizontal
              data={topCompanies}
              keyExtractor={(c) => 'co-' + c.name}
              renderItem={({ item }) => {
                const [bg, fg] = colorForCompany(item.name);
                return (
                  <TouchableOpacity onPress={() => router.push({ pathname: '/(tabs)/search', params: { q: item.name } })} activeOpacity={0.8} style={{ width: 145, backgroundColor: colors.card, borderWidth: 0.5, borderColor: colors.cardBorder, borderRadius: 12, padding: 12, marginRight: 8 }}>
                    <View style={{ flexDirection: 'row', alignItems: 'center', gap: 8, marginBottom: 7 }}>
                      <View style={{ width: 30, height: 30, borderRadius: 7, backgroundColor: bg, alignItems: 'center', justifyContent: 'center' }}>
                        <Text style={{ fontSize: 12, color: fg, fontFamily: 'DMSans_700Bold' }}>{(item.name[0] || '?').toUpperCase()}</Text>
                      </View>
                      <View style={{ flex: 1, minWidth: 0 }}>
                        <Text numberOfLines={1} style={{ fontSize: 11, color: colors.text, fontFamily: 'DMSans_600SemiBold' }}>{item.name}</Text>
                      </View>
                    </View>
                    <Text style={{ fontSize: 9, color: colors.primary, marginBottom: 4, fontFamily: 'DMSans_500Medium' }}>{item.count} open role{item.count > 1 ? 's' : ''}</Text>
                    <Text style={{ fontSize: 9, color: colors.textDim, fontFamily: 'DMSans_400Regular' }}>View jobs →</Text>
                  </TouchableOpacity>
                );
              }}
              showsHorizontalScrollIndicator={false}
              contentContainerStyle={{ paddingHorizontal: 16 }}
            />
          </>
        ) : null}

        {/* Career insights */}
        <SectionHeader
          title="Career insights"
          onPress={() => WebBrowser.openBrowserAsync('https://www.jobsaisle.com/blog', { toolbarColor: colors.bg, controlsColor: colors.primary })}
          linkText="All →"
        />
        <ScrollView horizontal showsHorizontalScrollIndicator={false} contentContainerStyle={{ paddingHorizontal: 16 }}>
          {[
            { tag: 'AI & WORK', title: 'How to Use ChatGPT to Land a Job', read: '5 min read', from: '#67E8F9', to: '#0EA5E9' },
            { tag: 'INTERVIEW', title: 'Top 10 Behavioral Questions in 2026', read: '8 min read', from: '#F472B6', to: '#A855F7' },
            { tag: 'SALARY', title: 'How to Negotiate Your First Offer', read: '6 min read', from: '#FCD34D', to: '#F59E0B' },
          ].map((p) => (
            <TouchableOpacity
              key={p.title}
              onPress={() => WebBrowser.openBrowserAsync('https://www.jobsaisle.com/blog', { toolbarColor: colors.bg, controlsColor: colors.primary })}
              activeOpacity={0.85}
              style={{ width: 200, backgroundColor: colors.card, borderWidth: 0.5, borderColor: colors.cardBorder, borderRadius: 12, overflow: 'hidden', marginRight: 8 }}>
              <View style={{ height: 80, backgroundColor: p.from, padding: 8, justifyContent: 'flex-end' }}>
                <View style={{ alignSelf: 'flex-start', backgroundColor: 'rgba(12,20,16,0.7)', paddingHorizontal: 7, paddingVertical: 3, borderRadius: 5 }}>
                  <Text style={{ fontSize: 8, color: colors.text, fontFamily: 'DMSans_700Bold', letterSpacing: 0.4 }}>{p.tag}</Text>
                </View>
              </View>
              <View style={{ padding: 11 }}>
                <Text numberOfLines={2} style={{ fontSize: 11, color: colors.text, fontFamily: 'DMSans_600SemiBold', lineHeight: 14 }}>{p.title}</Text>
                <Text style={{ fontSize: 9, color: colors.textDim, marginTop: 5, fontFamily: 'DMSans_400Regular' }}>{p.read}</Text>
              </View>
            </TouchableOpacity>
          ))}
        </ScrollView>
      </ScrollView>
    </SafeAreaView>
  );
}
